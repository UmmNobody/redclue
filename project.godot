;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RedClue"
run/main_scene="uid://c8051jbdx23f4"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DialogueManager="*uid://rvq2ofgdxfud"
EvidenceManager="*uid://cqh8uv36xi6yy"
GameState="*uid://cnk33ihfql7hf"
QuestManager="*uid://l5toywup5nq6"
StoryManager="*uid://66fopqyyph8e"
GameManager="*uid://bi4t7yko6bw62"
LocationManager="*uid://b1mxlagjj2cuq"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"david": "res://character/david.dch",
"holm": "res://character/holm.dch"
}
directories/dtl_directory={
"first_phone": "res://timeline/first_phone.dtl",
"short_message": "res://timeline/short_message.dtl"
}
layout/style_directory={
"": "res://scenes/ui/dialogic_style.tres",
"dialogic_style": "res://scenes/ui/dialogic_style.tres"
}
layout/style_list=["res://scenes/ui/dialogic_style.tres"]
layout/default_style="res://scenes/ui/dialogic_style.tres"
variables={
"short_message": ""
}

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[global_group]

